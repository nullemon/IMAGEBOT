# =========================================================================
# IMAGEBOT — copy this file to ".env" and fill in the keys you have.
# Everything is optional: the app still runs with NO keys (it falls back to
# a built-in rule-based parser + keyless DuckDuckGo image search).
# =========================================================================

# ---- Which AI provider to use for text (parsing news + writing captions) ----
# One of: claude | openai | gemini | grok | auto | none
# "auto" picks the first provider below that has a key set.
IMAGEBOT_TEXT_PROVIDER=auto

# ---- AI provider API keys ----------------------------------------------
# Claude (Anthropic) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Default model. Opus is most capable; for cheaper/faster parsing you can use
# claude-haiku-4-5 or claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI (ChatGPT) — https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# Grok (xAI) — https://console.x.ai/  (OpenAI-compatible API)
XAI_API_KEY=
XAI_MODEL=grok-2-latest
XAI_IMAGE_MODEL=grok-2-image

# Local Stable Diffusion (your GPU) — AUTOMATIC1111 / Forge / ComfyUI-compatible.
# Start your local server, then point this at it. Used for AI art generation.
IMAGEBOT_SD_URL=
IMAGEBOT_SD_MODEL=

# ---- Image search backend ----------------------------------------------
# Order tried: serpapi -> google_cse -> ddg (keyless). Keys below are optional;
# they give higher-quality, more reliable results than the keyless fallback.
# SerpApi (Google Images) — https://serpapi.com/
SERPAPI_KEY=
# Google Programmable Search — https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ---- Output ------------------------------------------------------------
IMAGEBOT_OUTPUT_DIR=output

# ---- Web UI ------------------------------------------------------------
IMAGEBOT_HOST=127.0.0.1
IMAGEBOT_PORT=5000
